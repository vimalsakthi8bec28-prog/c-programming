#include <stdio.h>
#include <stdlib.h> 

void update(int *a, int *b) {
    int original_a = *a;
    
    *a = original_a + *b;
    
    *b = abs(original_a - *b);
}

int main() {
    int a, b;
    int *pa = &a, *pb = &b;
    
    if (scanf("%d %d", &a, &b) == 2) {
        update(pa, pb);
        printf("%d\n%d\n", a, b);
    }
    
    return 0;
}
