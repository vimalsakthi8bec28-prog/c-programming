#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int next_permutation(int n, char **s)
{
    
{
    // 1. Find the largest index i such that s[i-1] < s[i]
    int i = n - 1;
    while (i > 0 && strcmp(s[i - 1], s[i]) >= 0) {
        i--;
    }

    // If no such index exists, this is the last permutation
    if (i <= 0) return 0;

    // 2. Find the largest index j such that s[j] > s[i-1]
    int j = n - 1;
    while (strcmp(s[j], s[i - 1]) <= 0) {
        j--;
    }

    // 3. Swap s[i-1] and s[j]
    char *tmp = s[i - 1];
    s[i - 1] = s[j];
    s[j] = tmp;

    // 4. Reverse the suffix starting at s[i]
    j = n - 1;
    while (i < j) {
        tmp = s[i];
        s[i] = s[j];
        s[j] = tmp;
        i++;
        j--;
    }

    return 1;
}
	/**
	* Complete this method
	* Return 0 when there is no next permutation and 1 otherwise
	* Modify array s to its next permutation
	*/
}

int main()
{
	char **s;
	int n;
	scanf("%d", &n);
	s = calloc(n, sizeof(char*));
	for (int i = 0; i < n; i++)
	{
		s[i] = calloc(11, sizeof(char));
		scanf("%s", s[i]);
	}
	do
	{
		for (int i = 0; i < n; i++)
			printf("%s%c", s[i], i == n - 1 ? '\n' : ' ');
	} while (next_permutation(n, s));
	for (int i = 0; i < n; i++)
		free(s[i]);
	free(s);
	return 0;
}
