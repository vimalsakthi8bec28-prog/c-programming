class Solution {
public:
    ListNode* swapPairs(ListNode* head) {
        // If the list is empty or has only one node, no swaps are needed
        if (head == nullptr || head->next == nullptr) {
            return head;
        }
        
        // Create a dummy node to act as the anchor before the head
        ListNode dummy(0);
        dummy.next = head;
        ListNode* prev = &dummy;
        
        // Loop runs as long as there is a pair of nodes available to swap
        while (prev->next != nullptr && prev->next->next != nullptr) {
            ListNode* first = prev->next;
            ListNode* second = first->next;
            
            // Adjust the pointers to perform the swap
            first->next = second->next;
            second->next = first;
            prev->next = second;
            
            // Move the pointer forward by two nodes for the next iteration
            prev = first;
        }
        
        return dummy.next;
    }
};
