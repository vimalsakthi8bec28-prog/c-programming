#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main()
{
	int int1, int2;
    float float1, float2;
    
    // Read the inputs from stdin
    if (scanf("%d %d", &int1, &int2) != 2) return 1;
    if (scanf("%f %f", &float1, &float2) != 2) return 1;
    
    // Print the sum and difference of the integers
    printf("%d %d\n", int1 + int2, int1 - int2);
    
    // Print the sum and difference of the floats rounded to 1 decimal place
    printf("%.1f %.1f\n", float1 + float2, float1 - float2);
    
    return 0;
}

    
    
   
