
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    // Array to store frequencies of digits 0 to 9 initialized to 0
    int digit_counts[10] = {0};
    char s[1001]; // Assuming a maximum string length of 1000 characters

    // Read the input string
    if (scanf("%1000s", s) == 1) {
        // Iterate through each character of the string
        for (int i = 0; s[i] != '\0'; i++) {
            // Check if the current character is a digit
            if (s[i] >= '0' && s[i] <= '9') {
                // Increment the frequency using the character's numeric value as index
                digit_counts[s[i] - '0']++;
            }
        }

        // Print the frequencies separated by a space
        for (int i = 0; i < 10; i++) {
            printf("%d", digit_counts[i]);
            if (i < 9) {
                printf(" ");
            }
        }
        printf("\n");
    }

    return 0;
}
