#include <limits.h>

int myAtoi(char* s) {
    if (s == NULL) {
        return 0;
    }

    int i = 0;
    int sign = 1;
    int result = 0;

    // Step 1: Read and ignore leading whitespace
    while (s[i] == ' ') {
        i++;
    }

    // Step 2: Check for a sign character '+' or '-'
    if (s[i] == '+') {
        sign = 1;
        i++;
    } else if (s[i] == '-') {
        sign = -1;
        i++;
    }

    // Step 3: Read in digits and stop at the first non-digit character
    while (s[i] >= '0' && s[i] <= '9') {
        int digit = s[i] - '0';

        // Check for 32-bit signed integer overflow
        // INT_MAX is 2147483647. If result > 214748364, next multiplication overflows.
        // If result == 214748364, it overflows if the next digit is greater than 7.
        if (result > INT_MAX / 10 || (result == INT_MAX / 10 && digit > INT_MAX % 10)) {
            return (sign == 1) ? INT_MAX : INT_MIN;
        }

        result = result * 10 + digit;
        i++;
    }

    return result * sign;
}
